 {
  "name": "halloween-inflatable",
  "eval": "(() => { d.tod.choose('night'); const w = d.world; for (let i = 0; i < 3000; i++) { w.update(-3614.8, -1581.7, 60); if (![...w.chunks.values()].some((k) => k.lod !== k.wantLod)) break; }\n  const cal = d.calendar; const L = [...cal.infl.values()][0]; d.camera.position.set(L[0], 6, L[2]); cal.dirty = true; cal.update(0.02, d.player, d.camera);\n  let best = [L[0] + 7, L[2] + 7]; for (let a = 0; a < 8; a++) { const x = L[0] + Math.cos(a * 0.785) * 7, z = L[2] + Math.sin(a * 0.785) * 7; if (!w.inBuilding(x, z, 1.5)) { best = [x, z]; break; } } return { c: [best[0], best[1], 1.7], t: [L[0], L[2], 1.3] }; })()"
 },
 {
